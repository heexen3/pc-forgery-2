# Copia este archivo como .env para cambiar los valores por defecto de docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Secreto para firmar los JWT (mínimo 32 caracteres). Debe ser el mismo en auth-service y api-gateway.
JWT_SECRET=pc-forgery-secreto-de-desarrollo-cambiar-en-produccion-2026
# Duración del access token en minutos (bájalo a 1 para demostrar la renovación con refresh token).
JWT_ACCESS_MINUTOS=15
CORS_ORIGINS=http://localhost:5173,https://heexen3.github.io
